<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Nada de e-browser se respalda ni se transfiere entre dispositivos:
         la configuracion, el candado y las apps instaladas son locales. -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
