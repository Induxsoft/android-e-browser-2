<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.InduxsoftEBrowser" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/induxsoft_rojo</item>
        <item name="colorPrimaryVariant">@color/induxsoft_rojo_oscuro</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorSecondary">@color/induxsoft_rojo</item>
        <item name="colorSecondaryVariant">@color/induxsoft_rojo_oscuro</item>
        <item name="colorOnSecondary">@color/blanco</item>
        <item name="android:statusBarColor">@color/induxsoft_rojo</item>
        <item name="android:windowBackground">@color/blanco</item>
        <!-- targetSdk 35 (Android 15) activa edge-to-edge por omisión: el WebView
             queda dibujado detrás de la barra de estado/navegación y los modales
             fixed quedan tapados. Esto restaura el comportamiento anterior
             (targetSdk 32). Se ignora sin problema en versiones < Android 15. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
